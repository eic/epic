<lccdd>
  <define>
    <comment>
      ### B0 Tracker Parameters
    </comment>
    <comment>
      Four AC-LGAD stations inside the B0 magnet, each with sensor modules on
      both faces of a support plate.
      - The stations sit on the ion axis, the axis of the hadron beam pipe, at
        B0TrackerStationN_zpos (global z, from a preliminary optimization).
      - The plate cut-outs are centred on the ion axis, as the CAD centres them on the
        beam pipe.
    </comment>
    <constant name="B0TrackerStation1_zpos" value="5850.0*mm"/>
    <constant name="B0TrackerStation2_zpos" value="6272.2*mm"/>
    <constant name="B0TrackerStation3_zpos" value="6601.0*mm"/>
    <constant name="B0TrackerStation4_zpos" value="6880.0*mm"/>
    <constant name="B0TrackerPCBThickness" value="1.0*mm"/>
    <constant name="B0TrackerCoolingSheetThickness" value="0.5*mm"/>
    <constant name="B0TrackerSensorThickness" value="0.05*mm"/>
    <constant name="B0TrackerASICThickness" value="0.3*mm"/>
    <constant name="B0TrackerPCBWidth" value="2.54*cm"/>
    <constant name="B0TrackerPCBLength" value="4.6*cm"/>
    <constant name="B0TrackerSensorWidth" value="1.6*cm"/>
    <constant name="B0TrackerSensorLength" value="1.6*cm"/>
    <constant name="B0TrackerSensorOverlap" value="1.0*mm"/>
    <constant name="B0TrackerASICWidth" value="B0TrackerSensorWidth"/>
    <constant name="B0TrackerASICLength" value="B0TrackerSensorLength"/>
    <!-- TrackingUnit stack: sensors, each on its ASIC, alternate between the two PCB faces -->
    <constant name="B0TrackerASIC_zpos" value="B0TrackerPCBThickness/2 + B0TrackerASICThickness/2"/>
    <constant name="B0TrackerSensor_zpos" value="B0TrackerPCBThickness/2 + B0TrackerASICThickness + B0TrackerSensorThickness/2"/>
    <constant name="B0TrackerSensor1_ypos" value="-(B0TrackerPCBLength - B0TrackerSensorLength)/2"/>
    <constant name="B0TrackerSensorPitch" value="B0TrackerSensorLength - B0TrackerSensorOverlap"/>
    <!-- Support: Al/Air/Al sandwich -->
    <constant name="B0TrackerSupportSkinThickness" value="1.0*mm"/>
    <constant name="B0TrackerSupportAirThickness" value="2.0*mm"/>
    <!-- ACTS material map binning copied to each front/back B0 tracking layer -->
    <constant name="B0TrackerLayerMaterialPhiBins" value="30"/>
    <constant name="B0TrackerLayerMaterialRBins" value="20"/>
  </define>
  <detectors>
    <!-- Empty negative endcap companion so ACTS sees B0 as the positive member of a two endcap hierarchy -->
    <detector id="B0TrackerCompanion_ID" name="B0TrackerCompanion" type="epic_CompositeTracker" actsType="endcap" vis="TrackerSubAssemblyVis">
      <type_flags type="DetType_TRACKER + DetType_ENDCAP"/>
      <position x="0*cm" y="0*cm" z="-4*um"/>
    </detector>
    <detector id="B0Tracker_Station_1_ID" name="B0Tracker" type="ip6_B0Tracker" readout="B0TrackerHits" vis="FFTrackerVis">
      <type_flags type="DetType_TRACKER + DetType_ENDCAP"/>
      <!-- Placed at the IP and rotated by the crossing angle, so the stations sit on the ion
           axis. ACTS assigns an endcap to the negative side if its z is below 0, so this z=0
           placement makes B0 the positive endcap, paired with the companion above -->
      <position x="0*mm" y="0*mm" z="0*mm"/>
      <rotation x="0*rad" y="ionCrossingAngle" z="0*rad"/>
      <!-- Empty ACTS layers `gap` outside the first and last faces, following the ForwardTOF
           approach (eic/epic#1089), so the ACTS volume covers every sensor. The faces are tilted by the
           crossing angle, so their sensors reach |x| sin(crossing angle), a few mm, beyond the
           layer in z, and `gap` must cover that. rmin and rmax only size the empty layers and
           must stay within the radial range of the faces -->
      <acts_guard gap="6*mm" rmin="40*mm" rmax="130*mm">
        <layer_material surface="representing" binning="binPhi,binR" bins0="B0TrackerLayerMaterialPhiBins" bins1="B0TrackerLayerMaterialRBins"/>
      </acts_guard>
      <!-- ACTS layer settings, shared by every face -->
      <envelope vis="FFTrackerLayerVis" zmin_tolerance="1*mm" zmax_tolerance="1*mm"/>
      <layer_material surface="inner" binning="binPhi,binR" bins0="B0TrackerLayerMaterialPhiBins" bins1="B0TrackerLayerMaterialRBins"/>
      <layer_material surface="outer" binning="binPhi,binR" bins0="B0TrackerLayerMaterialPhiBins" bins1="B0TrackerLayerMaterialRBins"/>
      <!-- Shared tracking unit, used by every face. Its frame is centered on its sensors, and
           its lowest-z face is mounted flush on the support stack -->
      <module name="TrackingUnit" vis="FFTrackerModuleVis">
        <module_component name="PCB" material="Fr4" vis="FFTrackerSupportVis">
          <box x="B0TrackerPCBWidth" y="B0TrackerPCBLength" z="B0TrackerPCBThickness"/>
          <position x="0.0*cm" y="0.0*cm" z="0.0*cm"/>
        </module_component>
        <module_component name="AlSheetOuter" material="Aluminum" vis="FFTrackerShieldingVis">
          <box x="B0TrackerPCBWidth" y="B0TrackerPCBLength" z="B0TrackerCoolingSheetThickness"/>
          <position x="0.0*cm" y="0.0*cm" z="B0TrackerSensor_zpos + B0TrackerSensorThickness/2 + B0TrackerCoolingSheetThickness/2"/>
        </module_component>
        <module_component name="ASIC1" material="Silicon" vis="FFTrackerServiceVis">
          <box x="B0TrackerASICWidth" y="B0TrackerASICLength" z="B0TrackerASICThickness"/>
          <position x="0.0*cm" y="B0TrackerSensor1_ypos" z="-B0TrackerASIC_zpos"/>
        </module_component>
        <module_component name="ASIC2" material="Silicon" vis="FFTrackerServiceVis">
          <box x="B0TrackerASICWidth" y="B0TrackerASICLength" z="B0TrackerASICThickness"/>
          <position x="0.0*cm" y="B0TrackerSensor1_ypos + B0TrackerSensorPitch" z="B0TrackerASIC_zpos"/>
        </module_component>
        <module_component name="ASIC3" material="Silicon" vis="FFTrackerServiceVis">
          <box x="B0TrackerASICWidth" y="B0TrackerASICLength" z="B0TrackerASICThickness"/>
          <position x="0.0*cm" y="B0TrackerSensor1_ypos + 2*B0TrackerSensorPitch" z="-B0TrackerASIC_zpos"/>
        </module_component>
        <module_component name="Sensor1" material="Silicon" vis="FFTrackerSurfaceVis" sensitive="true">
          <box x="B0TrackerSensorWidth" y="B0TrackerSensorLength" z="B0TrackerSensorThickness"/>
          <position x="0.0*cm" y="B0TrackerSensor1_ypos" z="-B0TrackerSensor_zpos"/>
        </module_component>
        <module_component name="Sensor2" material="Silicon" vis="FFTrackerSurfaceVis" sensitive="true">
          <box x="B0TrackerSensorWidth" y="B0TrackerSensorLength" z="B0TrackerSensorThickness"/>
          <position x="0.0*cm" y="B0TrackerSensor1_ypos + B0TrackerSensorPitch" z="B0TrackerSensor_zpos"/>
        </module_component>
        <module_component name="Sensor3" material="Silicon" vis="FFTrackerSurfaceVis" sensitive="true">
          <box x="B0TrackerSensorWidth" y="B0TrackerSensorLength" z="B0TrackerSensorThickness"/>
          <position x="0.0*cm" y="B0TrackerSensor1_ypos + 2*B0TrackerSensorPitch" z="-B0TrackerSensor_zpos"/>
        </module_component>
      </module>
      <!-- Support plates: this Al/air/Al stack, listed upstream to downstream, extruded along
           each plate outline -->
      <support_stack vis="FFTrackerSupportVis">
        <slice name="skin_upstream" material="Aluminum" thickness="B0TrackerSupportSkinThickness"/>
        <slice name="air" material="Air" thickness="B0TrackerSupportAirThickness"/>
        <slice name="skin_downstream" material="Aluminum" thickness="B0TrackerSupportSkinThickness"/>
      </support_stack>
