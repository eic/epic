<lccdd>
  <define>
    <comment>
      ### B0 Tracker Parameters
    </comment>
    <comment>
      Four AC-LGAD tracking stations inside the B0 magnet, each carrying
      sensor modules on both faces of a support plate. Station z positions are
      relative to B0TrackerCenter_zpos.
    </comment>
    <constant name="B0TrackerCenter_zpos" value="6099.75*mm"/>
    <constant name="B0TrackerCenter_xpos" value="-0.16000052*m"/>
    <constant name="B0Tracker_rotation" value="ionCrossingAngle"/>
    <constant name="B0TrackerLayer1_zstart" value="0*mm"/>
    <constant name="B0TrackerLayer2_zstart" value="276.086*mm"/>
    <constant name="B0TrackerLayer3_zstart" value="525.164*mm"/>
    <constant name="B0TrackerLayer4_zstart" value="750.234*mm"/>
    <constant name="B0TrackerLayerXOffset" value="10*mm"/>
    <constant name="B0TrackerPCBThickness" value="1.0*mm"/>
    <constant name="B0TrackerPCBAlThickness" value="0.5*mm"/>
    <constant name="B0TrackerSensorThickness" value="0.05*mm"/>
    <constant name="B0TrackerASICThickness" value="0.3*mm"/>
    <constant name="B0TrackerPCBWidth" value="2.54*cm"/>
    <constant name="B0TrackerPCBLength" value="4.6*cm"/>
    <constant name="B0TrackerSensorWidth" value="1.6*cm"/>
    <constant name="B0TrackerSensorLength" value="1.6*cm"/>
    <constant name="B0TrackerSensorOverlap" value="1.0*mm"/>
    <constant name="B0TrackerASICWidth" value="1.6*cm"/>
    <constant name="B0TrackerASICLength" value="1.6*cm"/>
    <constant name="B0TrackerASICOverlap" value="1.0*mm"/>
    <!-- Support: Al/Air/Al sandwich -->
    <constant name="B0TrackerSupportThickness" value="4.0*mm"/>
    <constant name="B0TrackerSupportSkinThickness" value="1.0*mm"/>
    <constant name="B0TrackerSupportAirThickness" value="2.0*mm"/>
    <constant name="B0TrackerModuleSupportFacingExtent" value="B0TrackerPCBThickness/2 + B0TrackerASICThickness + B0TrackerSensorThickness"/>
    <!-- Offset from support center to the module center, i.e. module face flush with the support -->
    <constant name="B0TrackerModuleOffsetFromSupport" value="B0TrackerSupportThickness/2 + B0TrackerModuleSupportFacingExtent"/>
    <!-- ACTS material map binning copied to each front/back B0 tracking layer -->
    <constant name="B0TrackerLayerMaterialPhiBins" value="30"/>
    <constant name="B0TrackerLayerMaterialRBins" value="20"/>
  </define>
  <detectors>
    <!-- Empty negative endcap companion so ACTS sees B0 as the positive member of a two endcap hierarchy -->
    <detector id="B0TrackerCompanion_ID" name="B0TrackerCompanion" type="epic_CompositeTracker" actsType="endcap" vis="TrackerSubAssemblyVis">
      <type_flags type="DetType_TRACKER + DetType_ENDCAP"/>
      <position x="0*cm" y="0*cm" z="-4*um"/>
    </detector>
    <!-- B0Tracker main detector -->
    <detector id="B0Tracker_Station_1_ID" name="B0Tracker" type="ip6_B0Tracker" readout="B0TrackerHits" vis="FFTrackerVis">
      <type_flags type="DetType_TRACKER + DetType_ENDCAP"/>
      <position x="B0TrackerCenter_xpos" y="0" z="B0TrackerCenter_zpos"/>
      <rotation x="0*rad" y="B0Tracker_rotation" z="0*rad"/>
      <!-- Shared tracking unit and CAD support plate definitions, used by every layer -->
      <module name="TrackingUnit" vis="FFTrackerModuleVis" offset_from_support="B0TrackerModuleOffsetFromSupport">
        <module_component name="PCB" material="Fr4" vis="FFTrackerSupportVis">
          <box x="B0TrackerPCBWidth" y="B0TrackerPCBLength" z="B0TrackerPCBThickness"/>
          <position x="0.0*cm" y="0.0*cm" z="0.0*cm"/>
        </module_component>
        <module_component name="AlSheetOuter" material="Aluminum" vis="FFTrackerShieldingVis">
          <box x="B0TrackerPCBWidth" y="B0TrackerPCBLength" z="B0TrackerPCBAlThickness"/>
          <position x="0.0*cm" y="0.0*cm" z="B0TrackerPCBThickness/2+B0TrackerASICThickness+B0TrackerSensorThickness+B0TrackerPCBAlThickness/2"/>
        </module_component>
        <module_component name="ASIC1" material="Silicon" vis="FFTrackerServiceVis">
          <box x="B0TrackerASICWidth" y="B0TrackerASICLength" z="B0TrackerASICThickness"/>
          <position x="0.0*cm" y="-(B0TrackerPCBLength-B0TrackerASICLength)/2" z="-(B0TrackerPCBThickness/2+B0TrackerASICThickness/2)"/>
        </module_component>
        <module_component name="ASIC2" material="Silicon" vis="FFTrackerServiceVis">
          <box x="B0TrackerASICWidth" y="B0TrackerASICLength" z="B0TrackerASICThickness"/>
          <position x="0.0*cm" y="-(B0TrackerPCBLength-B0TrackerASICLength)/2 + B0TrackerASICLength-B0TrackerASICOverlap" z="B0TrackerPCBThickness/2+B0TrackerASICThickness/2"/>
        </module_component>
        <module_component name="ASIC3" material="Silicon" vis="FFTrackerServiceVis">
          <box x="B0TrackerASICWidth" y="B0TrackerASICLength" z="B0TrackerASICThickness"/>
          <position x="0.0*cm" y="-(B0TrackerPCBLength-B0TrackerASICLength)/2 + 2*(B0TrackerASICLength-B0TrackerASICOverlap)" z="-(B0TrackerPCBThickness/2+B0TrackerASICThickness/2)"/>
        </module_component>
        <module_component name="Sensor1" material="Silicon" vis="FFTrackerSurfaceVis" sensitive="true">
          <box x="B0TrackerSensorWidth" y="B0TrackerSensorLength" z="B0TrackerSensorThickness"/>
          <position x="0.0*cm" y="-(B0TrackerPCBLength-B0TrackerSensorLength)/2" z="-(B0TrackerPCBThickness/2+B0TrackerASICThickness+B0TrackerSensorThickness/2)"/>
        </module_component>
        <module_component name="Sensor2" material="Silicon" vis="FFTrackerSurfaceVis" sensitive="true">
          <box x="B0TrackerSensorWidth" y="B0TrackerSensorLength" z="B0TrackerSensorThickness"/>
          <position x="0.0*cm" y="-(B0TrackerPCBLength-B0TrackerSensorLength)/2 + B0TrackerSensorLength-B0TrackerSensorOverlap" z="B0TrackerPCBThickness/2+B0TrackerASICThickness+B0TrackerSensorThickness/2"/>
        </module_component>
        <module_component name="Sensor3" material="Silicon" vis="FFTrackerSurfaceVis" sensitive="true">
          <box x="B0TrackerSensorWidth" y="B0TrackerSensorLength" z="B0TrackerSensorThickness"/>
          <position x="0.0*cm" y="-(B0TrackerPCBLength-B0TrackerSensorLength)/2 + 2*(B0TrackerSensorLength-B0TrackerSensorOverlap)" z="-(B0TrackerPCBThickness/2+B0TrackerASICThickness+B0TrackerSensorThickness/2)"/>
