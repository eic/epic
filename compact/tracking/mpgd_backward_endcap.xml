    <constant name="BackwardMPGD_zmax" value="BackwardMPGD_z2 + BackwardMPGD_z1" />

    <comment> Bases of trapezoids </comment>
    <constant name="BackwardMPGD_x1"
      value="2 * BackwardMPGD_IR1 * tan(BackwardMPGDEndcapMod_angle/2)" />
    <constant name="BackwardMPGD_x2"
      value="2 * BackwardMPGD_IR2 * sin(BackwardMPGDEndcapMod_angle/2)" />
