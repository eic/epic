    <constant name="BackwardMPGDDrift_thickness" value="BackwardMPGD_DriftFrame_thickness" />
    <constant name="BackwardMPGDCathode_thickness"
      value="BackwardMPGD_CathodeBulk_thickness 
                                                                    + BackwardMPGD_CathodeStructSkin_thickness 
                                                                    + BackwardMPGD_CathodeStructFrame_thickness 
