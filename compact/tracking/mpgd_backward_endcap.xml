    <!-- <constant name="BackwardMPGDFrame_thickness"   value="2*BackwardMPGDWindowGap_thickness +
    BackwardMPGDDriftGap_thickness"/> -->
    <constant name="BackwardMPGDEndcapMod_thickness"
      value="BackwardMPGDAnode_thickness + BackwardMPGDTransfer_thickess + BackwardMPGDDrift_thickness + BackwardMPGDCathode_thickness" />
    <constant name="BackwardMPGDEndcapLayer_thickness"
      value="BackwardMPGDEndcapMod_thickness + 2 * BackwardMPGDEndcapMod_dz + BackwardMPGDLayerPad" />


    <constant name="BackwardMPGD_rmin" value="BackwardMPGD_IR1 - BackwardMPGDLayerPad" />
    <constant name="BackwardMPGD_rmax" value="BackwardMPGD_OR4 + BackwardMPGDLayerPad" />
