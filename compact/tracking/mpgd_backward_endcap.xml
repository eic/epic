<lccdd>
  <define>
    <comment>
      --------------------------
      Backward MPGD Parameters
      --------------------------
    </comment>
    <comment> Backward MPGD position </comment>
    <constant name="BackwardMPGD_nlayers" value="2" />
    <constant name="BackwardMPGD_AllowedSpace" value="2.5*cm" />

    <comment> Parameters for the endcap MPGDs </comment>
    <constant name="BackwardMPGDEndcapMod_count" value="48" />
    <constant name="BackwardMPGDEndcapMod_dz" value="0" />
    <constant name="BackwardMPGDEndcap_overlap" value="0" />
    <constant name="BackwardMPGDMod_dzoffset" value="1.6*cm" />
    <constant name="BackwardMPGD_overlap" value="2.5*cm" />

    <comment> Layer definitions around the sensor for the endcap MPGDs </comment>
    <constant name="BackwardMPGD_IR1" value="50.0*mm" />
    <constant name="BackwardMPGD_IR2" value="65.0*mm" />
    <constant name="BackwardMPGD_IR3" value="68.0*mm" />
    <constant name="BackwardMPGD_OR1" value="460.0*mm" />
    <constant name="BackwardMPGD_OR2" value="405.0*mm" />
    <constant name="BackwardMPGD_OR3" value="400.0*mm" />
    <constant name="BackwardMPGD_OR4" value="420.0*mm" />

    <constant name="BackwardMPGD_AnodeFCCopper_thickness" value="5.0*um" />
    <constant name="BackwardMPGD_AnodeFCBulk_thickness" value="50*um" />
    <constant name="BackwardMPGD_AnodeStructSkin_thickness" value="100*um" />
    <constant name="BackwardMPGD_PCB_thickness" value="135*um" />
    <constant name="BackwardMPGD_AnodeStructFrame_thickness" value="3*mm" />
    <constant name="BackwardMPGD_AnodeStructCore_thickness" value="3*mm" />

    <constant name="BackwardMPGD_TransferGas_thickness" value="3.0*mm" />
    <constant name="BackwardMPGD_DriftGas_thickness" value="6.0*mm" />

    <constant name="BackwardMPGD_CathodeStructCore_thickness" value="3.0*mm" />
    <comment> Qui ci sarebbe un RWELL AA che non si sa cosa sia </comment>
    <constant name="BackwardMPGD_RWellAA_thickness" value="0.0*mm" />

    <constant name="BackwardMPGD_GEMtopAA_thickness" value="5.0*um" />
    <constant name="BackwardMPGD_GEMBottomAA_thickness" value="5.0*um" />

    <constant name="BackwardMPGD_CathodeAA_thickness" value="5.0*um" />
    <constant name="BackwardMPGD_TransferFrame_thickness" value="3.0*mm" />
    <constant name="BackwardMPGD_DriftFrame_thickness" value="6.0*mm" />
    <constant name="BackwardMPGD_CathodeStructFrame_thickness" value="3.0*mm" />

    <constant name="BackwardMPGD_GEMBulk_thickness" value="50*um" />
    <constant name="BackwardMPGD_CathodeBulk_thickness" value="50.0*um" />

    <constant name="BackwardMPGD_CathodeStructSkin_thickness" value="100*um" />
    <constant name="BackwardMPGD_CathodeFCBulk_thickness" value="50*um" />

    <constant name="BackwardMPGD_CathodeFCCopper_thickness" value="5.0*um" />
  </define>

  <comment>
    Actual detector implementation.
  </comment>

  <define>
    <constant name="BackwardMPGDEndcapMod_angle"
      value="360.0*degree/BackwardMPGDEndcapMod_count*(1.0 + BackwardMPGDEndcap_overlap)" />
    <comment> 1 um padding to not have layer and module touch (ACTS requirement) </comment>
    <constant name="BackwardMPGDLayerPad" value="0*um" />
    <comment> Detector thickness </comment>
    <constant name="BackwardMPGDAnode_thickness"
      value="BackwardMPGD_AnodeFCCopper_thickness 
                                                                    + BackwardMPGD_AnodeFCBulk_thickness 
                                                                    + BackwardMPGD_AnodeStructSkin_thickness 
                                                                    + BackwardMPGD_PCB_thickness 
                                                                    + BackwardMPGD_AnodeStructFrame_thickness" />
    <constant name="BackwardMPGDTransfer_thickess"
      value="BackwardMPGD_GEMBulk_thickness 
                                                                    + BackwardMPGD_DriftFrame_thickness" />
    <constant name="BackwardMPGDDrift_thickness" value="BackwardMPGD_DriftFrame_thickness" />
    <constant name="BackwardMPGDCathode_thickness"
      value="BackwardMPGD_CathodeBulk_thickness 
                                                                    + BackwardMPGD_CathodeStructSkin_thickness 
                                                                    + BackwardMPGD_CathodeStructFrame_thickness 
                                                                    + BackwardMPGD_CathodeStructSkin_thickness 
                                                                    + BackwardMPGD_CathodeFCBulk_thickness 
                                                                    + BackwardMPGD_CathodeFCCopper_thickness" />

    <!-- <constant name="BackwardMPGDFrame_thickness"   value="2*BackwardMPGDWindowGap_thickness +
    BackwardMPGDDriftGap_thickness"/> -->
    <constant name="BackwardMPGDEndcapMod_thickness"
      value="BackwardMPGDAnode_thickness + BackwardMPGDTransfer_thickess + BackwardMPGDDrift_thickness + BackwardMPGDCathode_thickness" />
    <constant name="BackwardMPGDEndcapLayer_thickness"
      value="BackwardMPGDEndcapMod_thickness + 2 * BackwardMPGDEndcapMod_dz + BackwardMPGDLayerPad" />


    <constant name="BackwardMPGD_rmin" value="BackwardMPGD_IR1 - BackwardMPGDLayerPad" />
    <constant name="BackwardMPGD_rmax" value="BackwardMPGD_OR4 + BackwardMPGDLayerPad" />
    <constant name="BackwardMPGD_zmin" value="BackwardMPGD_z1 - BackwardMPGD_z1" />
    <constant name="BackwardMPGD_zmax" value="BackwardMPGD_z2 + BackwardMPGD_z1" />

    <comment> Bases of trapezoids </comment>
    <constant name="BackwardMPGD_x1"
      value="2 * BackwardMPGD_IR1 * tan(BackwardMPGDEndcapMod_angle/2)" />
    <constant name="BackwardMPGD_x2"
      value="2 * BackwardMPGD_IR2 * sin(BackwardMPGDEndcapMod_angle/2)" />
    <constant name="BackwardMPGD_x3"
      value="2 * BackwardMPGD_IR3 * sin(BackwardMPGDEndcapMod_angle/2)" />

    <constant name="BackwardMPGD_X1"
      value="2 * BackwardMPGD_OR1 * sin(BackwardMPGDEndcapMod_angle/2)" />
    <constant name="BackwardMPGD_X2"
      value="2 * BackwardMPGD_OR2 * sin(BackwardMPGDEndcapMod_angle/2)" />
    <constant name="BackwardMPGD_X3"
      value="2 * BackwardMPGD_OR3 * sin(BackwardMPGDEndcapMod_angle/2)" />
    <constant name="BackwardMPGD_X4"
      value="2 * BackwardMPGD_OR4 * sin(BackwardMPGDEndcapMod_angle/2)" />

    <comment> Lenght of trapezoids </comment>
    <constant name="BackwardMPGD_Y1"
      value="BackwardMPGD_OR1 * cos(BackwardMPGDEndcapMod_angle/2) - BackwardMPGD_IR1" />
    <constant name="BackwardMPGD_Y2"
      value="BackwardMPGD_OR2 * cos(BackwardMPGDEndcapMod_angle/2) - BackwardMPGD_IR2" />
    <constant name="BackwardMPGD_Y3"
      value="BackwardMPGD_OR3 * cos(BackwardMPGDEndcapMod_angle/2) - BackwardMPGD_IR3" />
    <constant name="BackwardMPGD_Y4"
      value="BackwardMPGD_OR4 * cos(BackwardMPGDEndcapMod_angle/2) - BackwardMPGD_IR1" />

    <constant name="BackwardMPGD_a1"
      value="BackwardMPGD_IR2 *cos(BackwardMPGDEndcapMod_angle/2) - BackwardMPGD_IR1" />
    <constant name="BackwardMPGD_b1"
      value="BackwardMPGD_OR1 *cos(BackwardMPGDEndcapMod_angle/2) - BackwardMPGD_OR2" />

    <constant name="BackwardMPGD_a2"
      value="BackwardMPGD_OR3 *cos(BackwardMPGDEndcapMod_angle/2) - BackwardMPGD_IR3" />
    <constant name="BackwardMPGD_b2"
      value="BackwardMPGD_OR4 *cos(BackwardMPGDEndcapMod_angle/2) - BackwardMPGD_OR2" />
  </define>

  <detectors>
    <detector
      id="TrackerEndcapN_4_ID"
      name="BackwardMPGD"
      type="epic_MPGDTrapEndcapTracker"
      actsType="endcap"
      readout="BackwardMPGDEndcapHits"
      vis="MPGDVis"
      reflect="true">
      <type_flags type="DetType_TRACKER + DetType_ENDCAP" />
      <module name="BackwardModule1" vis="MPGDModuleVis">
        <trd x1="BackwardMPGD_x1/2.0" x2="BackwardMPGD_X1/2.0" z="BackwardMPGD_Y1/2" />
        <box x="BackwardMPGD_overlap/2.0" z="BackwardMPGD_OR4/2.0 - BackwardMPGD_IR1/2.0"
          Z="BackwardMPGD_OR1/2.0 - BackwardMPGD_IR1/2.0" />

        <module_component thickness="BackwardMPGD_CathodeFCCopper_thickness"
          x2="BackwardMPGD_X4/2.0" height="BackwardMPGD_Y4/2.0" material="Copper" sensitive="false"
          vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_CathodeFCBulk_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_CathodeStructSkin_thickness"
          x2="BackwardMPGD_X4/2.0" height="BackwardMPGD_Y4/2.0" material="Fiberglass"
          sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_CathodeBulk_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_GEMBulk_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />

        <!-- <module_component thickness = "BackwardMPGD_CathodeStructFrame_thickness" material =
        "Fiberglass" sensitive = "false" vis = "MPGDVis"/> -->
        <!-- <module_component thickness = "BackwardMPGD_DriftFrame_thickness" material = "PEEK"
        sensitive = "false" vis = "MPGDVis"/> -->
        <!-- <module_component thickness = "BackwardMPGD_TransferFrame_thickness" material = "PEEK"
        sensitive = "false" vis = "MPGDVis"/> -->
        <module_component thickness="BackwardMPGD_CathodeAA_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />

        <module_component thickness="BackwardMPGD_GEMBottomAA_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_GEMtopAA_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />

        <!-- <module_component thickness = "BackwardMPGD_RWellAA_thickness" material = "?????"
        sensitive = "false" vis = "MPGDVis"/> -->
        <module_component thickness="BackwardMPGD_CathodeStructCore_thickness"
          x2="BackwardMPGD_X4/2.0" height="BackwardMPGD_Y4/2.0" material="Honeycomb"
          sensitive="false" vis="MPGDVis" />

        <module_component thickness="BackwardMPGD_DriftGas_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Ar90IsoButane" sensitive="true" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_TransferGas_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Ar90IsoButane" sensitive="false" vis="MPGDVis" />

        <module_component thickness="BackwardMPGD_AnodeStructCore_thickness" material="Honeycomb"
          sensitive="false" vis="MPGDVis" />

        <!-- <module_component thickness = "BackwardMPGD_AnodeStructFrame_thickness" material =
        "Fiberglass" sensitive = "false" vis = "MPGDVis"/> -->
        <module_component thickness="BackwardMPGD_PCB_thickness" height="BackwardMPGD_Y1/2.0"
          material="Fr4" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_AnodeStructSkin_thickness"
          height="BackwardMPGD_Y1/2.0" material="Fiberglass" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_AnodeFCBulk_thickness"
          height="BackwardMPGD_Y1/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_AnodeFCCopper_thickness"
          height="BackwardMPGD_Y1/2.0" material="Copper" sensitive="false" vis="MPGDVis" />
      </module>
        <!-- <module_component thickness = "BackwardMPGD_AnodeStructFrame_thickness" material =
        "Fiberglass" sensitive = "false" vis = "MPGDVis"/> -->


      <module name="BackwardModule2" vis="MPGDModuleVis">
        <trd x1="BackwardMPGD_x1/2.0" x2="BackwardMPGD_X1/2.0" z="BackwardMPGD_Y1/2" />
        <box x="BackwardMPGD_overlap/2.0" z="BackwardMPGD_OR4/2.0 - BackwardMPGD_IR1/2.0"
          Z="BackwardMPGD_OR1/2.0 - BackwardMPGD_IR1/2.0" />


        <module_component thickness="BackwardMPGD_AnodeFCCopper_thickness"
          height="BackwardMPGD_Y1/2.0" material="Copper" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_AnodeFCBulk_thickness"
          height="BackwardMPGD_Y1/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_AnodeStructSkin_thickness"
          height="BackwardMPGD_Y1/2.0" material="Fiberglass" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_PCB_thickness" height="BackwardMPGD_Y1/2.0"
          material="Fr4" sensitive="false" vis="MPGDVis" />


        <module_component thickness="BackwardMPGD_AnodeStructCore_thickness" material="Honeycomb"
          sensitive="false" vis="MPGDVis" />


        <module_component thickness="BackwardMPGD_TransferGas_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Ar90IsoButane" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_DriftGas_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Ar90IsoButane" sensitive="true" vis="MPGDVis" />


        <module_component thickness="BackwardMPGD_CathodeStructCore_thickness"
          x2="BackwardMPGD_X4/2.0" height="BackwardMPGD_Y4/2.0" material="Honeycomb"
          sensitive="false" vis="MPGDVis" />
        <!-- <module_component thickness = "BackwardMPGD_RWellAA_thickness" material = "?????"
        sensitive = "false" vis = "MPGDVis"/> -->

        <module_component thickness="BackwardMPGD_GEMtopAA_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_GEMBottomAA_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />

        <module_component thickness="BackwardMPGD_CathodeAA_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />

        <!-- <module_component thickness = "BackwardMPGD_TransferFrame_thickness" material = "PEEK"
        sensitive = "false" vis = "MPGDVis"/> -->
        <!-- <module_component thickness = "BackwardMPGD_DriftFrame_thickness" material = "PEEK"
        sensitive = "false" vis = "MPGDVis"/> -->
        <!-- <module_component thickness = "BackwardMPGD_CathodeStructFrame_thickness" material =
        "Fiberglass" sensitive = "false" vis = "MPGDVis"/> -->

        <module_component thickness="BackwardMPGD_GEMBulk_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_CathodeBulk_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_CathodeStructSkin_thickness"
          x2="BackwardMPGD_X4/2.0" height="BackwardMPGD_Y4/2.0" material="Fiberglass"
          sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_CathodeFCBulk_thickness" x2="BackwardMPGD_X4/2.0"
          height="BackwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="BackwardMPGD_CathodeFCCopper_thickness"
          x2="BackwardMPGD_X4/2.0" height="BackwardMPGD_Y4/2.0" material="Copper" sensitive="false"
          vis="MPGDVis" />



      </module>



      <layer id="1">
        <envelope vis="MPGDLayerVis"
          rmin="BackwardMPGD_IR1"
          rmax="sqrt(BackwardMPGD_overlap*BackwardMPGD_overlap+BackwardMPGD_OR1*BackwardMPGD_OR1)"
          length="2 * BackwardMPGDEndcapLayer_thickness + 2 * BackwardMPGDMod_dzoffset"
          zstart="BackwardMPGD_z1" />
        <layer_material surface="inner" binning="binPhi,binR" bins0="BackwardMPGDEndcapMod_count"
          bins1="50" />
        <layer_material surface="outer" binning="binPhi,binR" bins0="BackwardMPGDEndcapMod_count"
          bins1="50" />
        <ring
          r="BackwardMPGD_IR1 + BackwardMPGD_Y1/2.0"
          R="BackwardMPGD_IR1/2.0 + BackwardMPGD_OR1/2.0"
          zstart="0"
          nmodules="BackwardMPGDEndcapMod_count"
          dz="BackwardMPGDEndcapMod_dz"
          dz_offset="BackwardMPGDMod_dzoffset"
          phi0="2*pi/BackwardMPGDEndcapMod_count/2.0"
          module="BackwardModule1" />
      </layer>

      <layer id="2">
        <envelope vis="MPGDLayerVis"
          rmin="BackwardMPGD_IR1"
          rmax="sqrt(BackwardMPGD_overlap*BackwardMPGD_overlap+BackwardMPGD_OR1*BackwardMPGD_OR1)"
          length="2 * BackwardMPGDEndcapLayer_thickness + 2 * BackwardMPGDMod_dzoffset"
          zstart="BackwardMPGD_z2" />
        <layer_material surface="inner" binning="binPhi,binR" bins0="BackwardMPGDEndcapMod_count"
          bins1="50" />
        <layer_material surface="outer" binning="binPhi,binR" bins0="BackwardMPGDEndcapMod_count"
          bins1="50" />
        <ring
          r="BackwardMPGD_IR1 + BackwardMPGD_Y1/2.0"
          R="BackwardMPGD_IR1/2.0 + BackwardMPGD_OR1/2.0"
          zstart="0"
          nmodules="BackwardMPGDEndcapMod_count"
          dz="BackwardMPGDEndcapMod_dz"
          dz_offset="BackwardMPGDMod_dzoffset"
          phi0="2*pi/BackwardMPGDEndcapMod_count/2.0"
          module="BackwardModule2" />
      </layer>
    </detector>
  </detectors>

  <plugins>
    <plugin name="DD4hep_ParametersPlugin">
      <argument value="BackwardMPGD" />
      <argument value="layer_pattern: str=BackwardMPGD_layer\d_N" />
    </plugin>
  </plugins>

  <readouts>
    <readout name="BackwardMPGDEndcapHits">
      <segmentation type="CartesianGridXZ" grid_size_x="sqrt(12)*150*um"
        grid_size_z="sqrt(12)*150*um" />
      <id>system:8,layer:2,module:6,sensor:16,x:32:-16,z:-16</id>
    </readout>
  </readouts>

</lccdd>