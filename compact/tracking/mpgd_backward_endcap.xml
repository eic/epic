                                                                    + BackwardMPGD_PCB_thickness 
                                                                    + BackwardMPGD_AnodeStructFrame_thickness" />
    <constant name="BackwardMPGDTransfer_thickess"
      value="BackwardMPGD_GEMBulk_thickness 
