    <constant name="BackwardMPGD_X4"
      value="2 * BackwardMPGD_OR4 * sin(BackwardMPGDEndcapMod_angle/2)" />

    <comment> Lenght of trapezoids </comment>
    <constant name="BackwardMPGD_Y1"
      value="BackwardMPGD_OR1 * cos(BackwardMPGDEndcapMod_angle/2) - BackwardMPGD_IR1" />
    <constant name="BackwardMPGD_Y2"
