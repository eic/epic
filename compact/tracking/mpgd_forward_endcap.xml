<lccdd>
  <define>
    <comment>
      --------------------------
      Forward MPGD Parameters
      --------------------------
    </comment>
    <comment> Forward MPGD position </comment>
    <constant name="ForwardMPGD_nlayers" value="2" />
    <constant name="ForwardMPGD_AllowedSpace" value="2.5*cm" />

    <comment> Parameters for the endcap MPGDs </comment>
    <constant name="ForwardMPGDEndcapMod_count" value="48" />
    <constant name="ForwardMPGDEndcapMod_dz" value="0" />
    <constant name="ForwardMPGDEndcap_overlap" value="0" />
    <constant name="ForwardMPGDMod_dzoffset" value="1.6*cm" />
    <constant name="ForwardMPGD_overlap" value="2.5*cm" />

    <comment> Layer definitions around the sensor for the endcap MPGDs </comment>
    <constant name="ForwardMPGD_IR1" value="90.0*mm" />
    <constant name="ForwardMPGD_IR2" value="105.0*mm" />
    <constant name="ForwardMPGD_IR3" value="108.0*mm" />
    <constant name="ForwardMPGD_OR1" value="500.0*mm" />
    <constant name="ForwardMPGD_OR2" value="453.0*mm" />
    <constant name="ForwardMPGD_OR3" value="450.0*mm" />
    <constant name="ForwardMPGD_OR4" value="468.0*mm" />

    <constant name="ForwardMPGD_AnodeFCCopper_thickness" value="5.0*um" />
    <constant name="ForwardMPGD_AnodeFCBulk_thickness" value="50*um" />
    <constant name="ForwardMPGD_AnodeStructSkin_thickness" value="100*um" />
    <constant name="ForwardMPGD_PCB_thickness" value="135*um" />
    <constant name="ForwardMPGD_AnodeStructFrame_thickness" value="3*mm" />
    <constant name="ForwardMPGD_AnodeStructCore_thickness" value="3*mm" />

    <constant name="ForwardMPGD_TransferGas_thickness" value="3.0*mm" />
    <constant name="ForwardMPGD_DriftGas_thickness" value="6.0*mm" />

    <constant name="ForwardMPGD_CathodeStructCore_thickness" value="3.0*mm" />
    <comment> Qui ci sarebbe un RWELL AA che non si sa cosa sia </comment>
    <constant name="ForwardMPGD_RWellAA_thickness" value="0.0*mm" />

    <constant name="ForwardMPGD_GEMtopAA_thickness" value="5.0*um" />
    <constant name="ForwardMPGD_GEMBottomAA_thickness" value="5.0*um" />

    <constant name="ForwardMPGD_CathodeAA_thickness" value="5.0*um" />
    <constant name="ForwardMPGD_TransferFrame_thickness" value="3.0*mm" />
    <constant name="ForwardMPGD_DriftFrame_thickness" value="6.0*mm" />
    <constant name="ForwardMPGD_CathodeStructFrame_thickness" value="3.0*mm" />

    <constant name="ForwardMPGD_GEMBulk_thickness" value="50*um" />
    <constant name="ForwardMPGD_CathodeBulk_thickness" value="50.0*um" />

    <constant name="ForwardMPGD_CathodeStructSkin_thickness" value="100*um" />
    <constant name="ForwardMPGD_CathodeFCBulk_thickness" value="50*um" />

    <constant name="ForwardMPGD_CathodeFCCopper_thickness" value="5.0*um" />
  </define>

  <comment>
    Actual detector implementation.
  </comment>

  <define>
    <constant name="ForwardMPGDEndcapMod_angle"
      value="360.0*degree/ForwardMPGDEndcapMod_count*(1.0 + ForwardMPGDEndcap_overlap)" />
    <comment> 1 um padding to not have layer and module touch (ACTS requirement) </comment>
    <constant name="ForwardMPGDLayerPad" value="0*um" />
    <comment> Detector thickness </comment>
    <constant name="ForwardMPGDAnode_thickness"
      value="ForwardMPGD_AnodeFCCopper_thickness 
                                                                    + ForwardMPGD_AnodeFCBulk_thickness 
                                                                    + ForwardMPGD_AnodeStructSkin_thickness 
                                                                    + ForwardMPGD_PCB_thickness 
                                                                    + ForwardMPGD_AnodeStructFrame_thickness" />
    <constant name="ForwardMPGDTransfer_thickess"
      value="ForwardMPGD_GEMBulk_thickness 
                                                                    + ForwardMPGD_DriftFrame_thickness" />
    <constant name="ForwardMPGDDrift_thickness" value="ForwardMPGD_DriftFrame_thickness" />
    <constant name="ForwardMPGDCathode_thickness"
      value="ForwardMPGD_CathodeBulk_thickness 
                                                                    + ForwardMPGD_CathodeStructSkin_thickness 
                                                                    + ForwardMPGD_CathodeStructFrame_thickness 
                                                                    + ForwardMPGD_CathodeStructSkin_thickness 
                                                                    + ForwardMPGD_CathodeFCBulk_thickness 
                                                                    + ForwardMPGD_CathodeFCCopper_thickness" />

    <!-- <constant name="ForwardMPGDFrame_thickness"   value="2*ForwardMPGDWindowGap_thickness +
    ForwardMPGDDriftGap_thickness"/> -->
    <constant name="ForwardMPGDEndcapMod_thickness"
      value="ForwardMPGDAnode_thickness + ForwardMPGDTransfer_thickess + ForwardMPGDDrift_thickness + ForwardMPGDCathode_thickness" />
    <constant name="ForwardMPGDEndcapLayer_thickness"
      value="ForwardMPGDEndcapMod_thickness + 2 * ForwardMPGDEndcapMod_dz + ForwardMPGDLayerPad" />


    <constant name="ForwardMPGD_rmin" value="ForwardMPGD_IR1 - ForwardMPGDLayerPad" />
    <constant name="ForwardMPGD_rmax" value="ForwardMPGD_OR4 + ForwardMPGDLayerPad" />
    <constant name="ForwardMPGD_zmin" value="ForwardMPGD_z1 - ForwardMPGD_z1" />
    <constant name="ForwardMPGD_zmax" value="ForwardMPGD_z2 + ForwardMPGD_z1" />

    <comment> Bases of trapezoids </comment>
    <constant name="ForwardMPGD_x1"
      value="2 * ForwardMPGD_IR1 * tan(ForwardMPGDEndcapMod_angle/2)" />
    <constant name="ForwardMPGD_x2"
      value="2 * ForwardMPGD_IR2 * sin(ForwardMPGDEndcapMod_angle/2)" />
    <constant name="ForwardMPGD_x3"
      value="2 * ForwardMPGD_IR3 * sin(ForwardMPGDEndcapMod_angle/2)" />

    <constant name="ForwardMPGD_X1"
      value="2 * ForwardMPGD_OR1 * sin(ForwardMPGDEndcapMod_angle/2)" />
    <constant name="ForwardMPGD_X2"
      value="2 * ForwardMPGD_OR2 * sin(ForwardMPGDEndcapMod_angle/2)" />
    <constant name="ForwardMPGD_X3"
      value="2 * ForwardMPGD_OR3 * sin(ForwardMPGDEndcapMod_angle/2)" />
    <constant name="ForwardMPGD_X4"
      value="2 * ForwardMPGD_OR4 * sin(ForwardMPGDEndcapMod_angle/2)" />

    <comment> Lenght of trapezoids </comment>
    <constant name="ForwardMPGD_Y1"
      value="ForwardMPGD_OR1 * cos(ForwardMPGDEndcapMod_angle/2) - ForwardMPGD_IR1" />
    <constant name="ForwardMPGD_Y2"
      value="ForwardMPGD_OR2 * cos(ForwardMPGDEndcapMod_angle/2) - ForwardMPGD_IR2" />
    <constant name="ForwardMPGD_Y3"
      value="ForwardMPGD_OR3 * cos(ForwardMPGDEndcapMod_angle/2) - ForwardMPGD_IR3" />
    <constant name="ForwardMPGD_Y4"
      value="ForwardMPGD_OR4 * cos(ForwardMPGDEndcapMod_angle/2) - ForwardMPGD_IR1" />

    <constant name="ForwardMPGD_a1"
      value="ForwardMPGD_IR2 *cos(ForwardMPGDEndcapMod_angle/2) - ForwardMPGD_IR1" />
    <constant name="ForwardMPGD_b1"
      value="ForwardMPGD_OR1 *cos(ForwardMPGDEndcapMod_angle/2) - ForwardMPGD_OR2" />

    <constant name="ForwardMPGD_a2"
      value="ForwardMPGD_OR3 *cos(ForwardMPGDEndcapMod_angle/2) - ForwardMPGD_IR3" />
    <constant name="ForwardMPGD_b2"
      value="ForwardMPGD_OR4 *cos(ForwardMPGDEndcapMod_angle/2) - ForwardMPGD_OR2" />
  </define>

  <detectors>
    <detector
      id="TrackerEndcapN_5_ID"
      name="ForwardMPGD"
      type="epic_MPGDTrapEndcapTracker"
      actsType="endcap"
      readout="ForwardMPGDEndcapHits"
      vis="MPGDVis"
      reflect="false">
      <type_flags type="DetType_TRACKER + DetType_ENDCAP" />
      <module name="ForwardModule1" vis="MPGDModuleVis">
        <trd x1="ForwardMPGD_x1/2.0" x2="ForwardMPGD_X1/2.0" z="ForwardMPGD_Y1/2" />
        <box x="ForwardMPGD_overlap/2.0" z="ForwardMPGD_OR4/2.0 - ForwardMPGD_IR1/2.0"
          Z="ForwardMPGD_OR1/2.0 - ForwardMPGD_IR1/2.0" />

        <module_component thickness="ForwardMPGD_CathodeFCCopper_thickness"
          x2="ForwardMPGD_X4/2.0" height="ForwardMPGD_Y4/2.0" material="Copper" sensitive="false"
          vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_CathodeFCBulk_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_CathodeStructSkin_thickness"
          x2="ForwardMPGD_X4/2.0" height="ForwardMPGD_Y4/2.0" material="Fiberglass"
          sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_CathodeBulk_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_GEMBulk_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />

        <!-- <module_component thickness = "ForwardMPGD_CathodeStructFrame_thickness" material =
        "Fiberglass" sensitive = "false" vis = "MPGDVis"/> -->
        <!-- <module_component thickness = "ForwardMPGD_DriftFrame_thickness" material = "PEEK"
        sensitive = "false" vis = "MPGDVis"/> -->
        <!-- <module_component thickness = "ForwardMPGD_TransferFrame_thickness" material = "PEEK"
        sensitive = "false" vis = "MPGDVis"/> -->
        <module_component thickness="ForwardMPGD_CathodeAA_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />

        <module_component thickness="ForwardMPGD_GEMBottomAA_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_GEMtopAA_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />

        <!-- <module_component thickness = "ForwardMPGD_RWellAA_thickness" material = "?????"
        sensitive = "false" vis = "MPGDVis"/> -->
        <module_component thickness="ForwardMPGD_CathodeStructCore_thickness"
          x2="ForwardMPGD_X4/2.0" height="ForwardMPGD_Y4/2.0" material="Honeycomb"
          sensitive="false" vis="MPGDVis" />

        <module_component thickness="ForwardMPGD_DriftGas_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Ar90IsoButane" sensitive="true" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_TransferGas_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Ar90IsoButane" sensitive="false" vis="MPGDVis" />

        <module_component thickness="ForwardMPGD_AnodeStructCore_thickness" material="Honeycomb"
          sensitive="false" vis="MPGDVis" />

        <!-- <module_component thickness = "ForwardMPGD_AnodeStructFrame_thickness" material =
        "Fiberglass" sensitive = "false" vis = "MPGDVis"/> -->
        <module_component thickness="ForwardMPGD_PCB_thickness" height="ForwardMPGD_Y1/2.0"
          material="Fr4" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_AnodeStructSkin_thickness"
          height="ForwardMPGD_Y1/2.0" material="Fiberglass" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_AnodeFCBulk_thickness"
          height="ForwardMPGD_Y1/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_AnodeFCCopper_thickness"
          height="ForwardMPGD_Y1/2.0" material="Copper" sensitive="false" vis="MPGDVis" />
      </module>
        <!-- <module_component thickness = "ForwardMPGD_AnodeStructFrame_thickness" material =
        "Fiberglass" sensitive = "false" vis = "MPGDVis"/> -->


      <module name="ForwardModule2" vis="MPGDModuleVis">
        <trd x1="ForwardMPGD_x1/2.0" x2="ForwardMPGD_X1/2.0" z="ForwardMPGD_Y1/2" />
        <box x="ForwardMPGD_overlap/2.0" z="ForwardMPGD_OR4/2.0 - ForwardMPGD_IR1/2.0"
          Z="ForwardMPGD_OR1/2.0 - ForwardMPGD_IR1/2.0" />


        <module_component thickness="ForwardMPGD_AnodeFCCopper_thickness"
          height="ForwardMPGD_Y1/2.0" material="Copper" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_AnodeFCBulk_thickness"
          height="ForwardMPGD_Y1/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_AnodeStructSkin_thickness"
          height="ForwardMPGD_Y1/2.0" material="Fiberglass" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_PCB_thickness" height="ForwardMPGD_Y1/2.0"
          material="Fr4" sensitive="false" vis="MPGDVis" />


        <module_component thickness="ForwardMPGD_AnodeStructCore_thickness" material="Honeycomb"
          sensitive="false" vis="MPGDVis" />


        <module_component thickness="ForwardMPGD_TransferGas_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Ar90IsoButane" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_DriftGas_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Ar90IsoButane" sensitive="true" vis="MPGDVis" />


        <module_component thickness="ForwardMPGD_CathodeStructCore_thickness"
          x2="ForwardMPGD_X4/2.0" height="ForwardMPGD_Y4/2.0" material="Honeycomb"
          sensitive="false" vis="MPGDVis" />
        <!-- <module_component thickness = "ForwardMPGD_RWellAA_thickness" material = "?????"
        sensitive = "false" vis = "MPGDVis"/> -->

        <module_component thickness="ForwardMPGD_GEMtopAA_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_GEMBottomAA_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />

        <module_component thickness="ForwardMPGD_CathodeAA_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Copper" sensitive="false" vis="MPGDVis" />

        <!-- <module_component thickness = "ForwardMPGD_TransferFrame_thickness" material = "PEEK"
        sensitive = "false" vis = "MPGDVis"/> -->
        <!-- <module_component thickness = "ForwardMPGD_DriftFrame_thickness" material = "PEEK"
        sensitive = "false" vis = "MPGDVis"/> -->
        <!-- <module_component thickness = "ForwardMPGD_CathodeStructFrame_thickness" material =
        "Fiberglass" sensitive = "false" vis = "MPGDVis"/> -->

        <module_component thickness="ForwardMPGD_GEMBulk_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_CathodeBulk_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_CathodeStructSkin_thickness"
          x2="ForwardMPGD_X4/2.0" height="ForwardMPGD_Y4/2.0" material="Fiberglass"
          sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_CathodeFCBulk_thickness" x2="ForwardMPGD_X4/2.0"
          height="ForwardMPGD_Y4/2.0" material="Kapton" sensitive="false" vis="MPGDVis" />
        <module_component thickness="ForwardMPGD_CathodeFCCopper_thickness"
          x2="ForwardMPGD_X4/2.0" height="ForwardMPGD_Y4/2.0" material="Copper" sensitive="false"
          vis="MPGDVis" />



      </module>



      <layer id="1">
        <envelope vis="MPGDLayerVis"
          rmin="ForwardMPGD_IR1"
          rmax="sqrt(ForwardMPGD_overlap*ForwardMPGD_overlap+ForwardMPGD_OR1*ForwardMPGD_OR1)"
          length="2 * ForwardMPGDEndcapLayer_thickness + 2 * ForwardMPGDMod_dzoffset"
          zstart="ForwardMPGD_z1" />
        <layer_material surface="inner" binning="binPhi,binR" bins0="ForwardMPGDEndcapMod_count"
          bins1="50" />
        <layer_material surface="outer" binning="binPhi,binR" bins0="ForwardMPGDEndcapMod_count"
          bins1="50" />
        <ring
          r="ForwardMPGD_IR1 + ForwardMPGD_Y1/2.0"
          R="ForwardMPGD_IR1/2.0 + ForwardMPGD_OR1/2.0"
          zstart="0"
          nmodules="ForwardMPGDEndcapMod_count"
          dz="ForwardMPGDEndcapMod_dz"
          dz_offset="ForwardMPGDMod_dzoffset"
          phi0="2*pi/ForwardMPGDEndcapMod_count/2.0"
          module="ForwardModule1" />
      </layer>

      <layer id="2">
        <envelope vis="MPGDLayerVis"
          rmin="ForwardMPGD_IR1"
          rmax="sqrt(ForwardMPGD_overlap*ForwardMPGD_overlap+ForwardMPGD_OR1*ForwardMPGD_OR1)"
          length="2 * ForwardMPGDEndcapLayer_thickness + 2 * ForwardMPGDMod_dzoffset"
          zstart="ForwardMPGD_z2" />
        <layer_material surface="inner" binning="binPhi,binR" bins0="ForwardMPGDEndcapMod_count"
          bins1="50" />
        <layer_material surface="outer" binning="binPhi,binR" bins0="ForwardMPGDEndcapMod_count"
          bins1="50" />
        <ring
          r="ForwardMPGD_IR1 + ForwardMPGD_Y1/2.0"
          R="ForwardMPGD_IR1/2.0 + ForwardMPGD_OR1/2.0"
          zstart="0"
          nmodules="ForwardMPGDEndcapMod_count"
          dz="ForwardMPGDEndcapMod_dz"
          dz_offset="ForwardMPGDMod_dzoffset"
          phi0="2*pi/ForwardMPGDEndcapMod_count/2.0"
          module="ForwardModule2" />
      </layer>
    </detector>
  </detectors>

  <plugins>
    <plugin name="DD4hep_ParametersPlugin">
      <argument value="ForwardMPGD" />
      <argument value="layer_pattern: str=ForwardMPGD_layer\d_N" />
    </plugin>
  </plugins>

  <readouts>
    <readout name="ForwardMPGDEndcapHits">
      <segmentation type="CartesianGridXZ" grid_size_x="sqrt(12)*150*um"
        grid_size_z="sqrt(12)*150*um" />
      <id>system:8,layer:2,module:6,sensor:16,x:32:-16,z:-16</id>
    </readout>
  </readouts>

</lccdd>