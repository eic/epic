        <module_component name="MirrorK9_Split_CrossBrace2_L3_End_ASCII.gdml" matching_name="K9" material="K9" sensitive="false" vis="TrackerLayerVis" file="CAD/L3/MirrorK9_Split_CrossBrace2_L3_End_ASCII.gdml" />
