        <module_component name="K9_Split_CrossBrace_L3_ASCII.gdml" matching_name="K9" material="K9" sensitive="false" vis="TrackerLayerVis" file="CAD/L3/K9_Split_CrossBrace_L3_ASCII.gdml" />
        <module_component name="K9_Split_CrossBrace_L3_End001_ASCII.gdml" matching_name="K9" material="K9" sensitive="false" vis="TrackerLayerVis" file="CAD/L3/K9_Split_CrossBrace_L3_End001_ASCII.gdml" />
