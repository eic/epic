<lccdd>
  <define>
    <comment>
         This version builds the silicon layers with a structure of LAS, HalfRSU, and curved segments. 
         The passive materal is modelled as tessellated solids imported from .gdml files.
    </comment>

    <constant name="SiBarrelSensorCu_thickness"         value="2.5*um" />
    <constant name="SiBarrelSensorActiveSi_thickness"   value="14*um" />
    <constant name="SiBarrelSensorInactiveSi_thickness" value="36*um" />
    <constant name="SiBarrelSensor_thickness" value="SiBarrelSensorCu_thickness + SiBarrelSensorActiveSi_thickness + SiBarrelSensorInactiveSi_thickness" />
    <constant name="SiBarrelSensorMod_thickness" value="SiBarrelSensor_thickness" />
    <constant name="SiBarrelSiliconGap_width" value="1*mm" />
    <constant name="SiBarrelStave1_width" value="3.848*cm" />
    <constant name="SiBarrelStave2_width" value="3.848*cm" />
    <constant name="SiBarrelStave1_length" value="51.3*cm"/>
    <constant name="SiBarrelStave2_length" value="80.3*cm" />
    <constant name="SiBarrelSingleModule1_length" value="12.9996*cm"/>
    <constant name="SiBarrelSingleModule2_length" value="10.833*cm" />
    <constant name="SiBarrel1_PassiveSi_Length" value="4.5*mm"/>
    <constant name="SiBarrel2_PassiveSi_Length" value="4.5*mm"/>
    <constant name="SiBarrelStave1_rc" value="26.5*cm" /> <!-- 26.5 cm is the average radius for inner sub-layer of 262mm and outer of 267mm-->
     <constant name="SiBarrelStave2_rc" value="42*cm" /> <!-- 42 cm, inner/outer 417mm, 423mm -->
   <constant name="SiBarrelStave1_count" value="44" />
    <constant name="SiBarrelStave2_count" value="70" />
    <constant name="SiBarrel1_radius_castellation" value="6*mm" />
    <constant name="SiBarrel2_radius_castellation" value="6*mm" />
    <constant name="SiBarrelStave1Lower_rc"         value="SiBarrelStave1_rc-SiBarrel1_radius_castellation/2" /> <!--get rmin of the lower modules -->
    <constant name="SiBarrelStave2Lower_rc"         value="SiBarrelStave2_rc-SiBarrel2_radius_castellation/2"/>

   <constant name="SiBarrelSiliconCurveNoSegments" value="5" />
   <constant name="SiBarrelSiliconCurveRadius" value="90.075*mm" />
   <constant name="SiBarrelSiliconHeightFromStaveCentre1" value="4.35*mm"/>
   <constant name="SiBarrelSiliconHeightFromStaveCentre2" value="4.35*mm"/>
   <constant name="SiBarrelLowerCurveAxis1" value="SiBarrelSiliconCurveRadius - SiBarrelSiliconHeightFromStaveCentre1" />
   <constant name="SiBarrelLowerCurveAxis2" value="SiBarrelSiliconCurveRadius - SiBarrelSiliconHeightFromStaveCentre2" />
   <constant name="SiBarrelUpperCurveAxis1" value=" - SiBarrelSiliconCurveRadius + SiBarrelSiliconHeightFromStaveCentre1" />
   <constant name="SiBarrelUpperCurveAxis2" value=" - SiBarrelSiliconCurveRadius + SiBarrelSiliconHeightFromStaveCentre2" />
   <constant name="SiBarrelSiliconCurveHalfAngle1" value="asin(0.5*SiBarrelStave1_width / SiBarrelSiliconCurveRadius)" />
   <constant name="SiBarrelSiliconCurveHalfAngle2" value="asin(0.5*SiBarrelStave2_width / SiBarrelSiliconCurveRadius)" />
   <constant name="SiBarrelSiliconGapHalfAngle" value="atan(0.5*SiBarrelSiliconGap_width / SiBarrelSiliconCurveRadius)" />
   <constant name="SiBarrel_ShortThickness" value="0.5*SiBarrelSensorMod_thickness" />
   <constant name="SiBarrel1_LongThickness" value="1.5*SiBarrelSensorMod_thickness + SiBarrelSiliconHeightFromStaveCentre1"  />
   <constant name="SiBarrel2_LongThickness" value="1.5*SiBarrelSensorMod_thickness + SiBarrelSiliconHeightFromStaveCentre2"  />

   <constant name="SiBarrel1_Module0_Position" value="-187.126*mm" />
   <constant name="SiBarrel1_Module1_Position" value="-62.7931*mm" />
   <constant name="SiBarrel1_Module2_Position" value="62.5436*mm" />
   <constant name="SiBarrel1_Module3_Position" value="186.8764*mm" />

   <constant name="SiBarrel2_Module0_Position" value="-342.83*mm" />
   <constant name="SiBarrel2_Module1_Position" value="-245.026*mm" />
   <constant name="SiBarrel2_Module2_Position" value="-147.216*mm" />
   <constant name="SiBarrel2_Module3_Position" value="-49.4071*mm" />
   <constant name="SiBarrel2_Module4_Position" value="49.4072*mm" />
   <constant name="SiBarrel2_Module5_Position" value="147.2164*mm" />
   <constant name="SiBarrel2_Module6_Position" value="245.0257*mm" />
   <constant name="SiBarrel2_Module7_Position" value="342.8342*mm" />

   <constant name="SiBarrel1_Passive0_Position" value="SiBarrel1_Module0_Position - SiBarrelSingleModule1_length/2 - SiBarrel1_PassiveSi_Length/2" />
   <constant name="SiBarrel1_Passive1_Position" value="SiBarrel1_Module1_Position - SiBarrelSingleModule1_length/2 - SiBarrel1_PassiveSi_Length/2" />
   <constant name="SiBarrel1_Passive2_Position" value="SiBarrel1_Module2_Position + SiBarrelSingleModule1_length/2 + SiBarrel1_PassiveSi_Length/2" />
   <constant name="SiBarrel1_Passive3_Position" value="SiBarrel1_Module3_Position + SiBarrelSingleModule1_length/2 + SiBarrel1_PassiveSi_Length/2" />

   <constant name="SiBarrel2_Passive0_Position" value="SiBarrel2_Module0_Position - SiBarrelSingleModule2_length/2 - SiBarrel2_PassiveSi_Length/2" />
   <constant name="SiBarrel2_Passive1_Position" value="SiBarrel2_Module1_Position - SiBarrelSingleModule2_length/2 - SiBarrel2_PassiveSi_Length/2" />
   <constant name="SiBarrel2_Passive2_Position" value="SiBarrel2_Module2_Position - SiBarrelSingleModule2_length/2 - SiBarrel2_PassiveSi_Length/2" />
   <constant name="SiBarrel2_Passive3_Position" value="SiBarrel2_Module3_Position - SiBarrelSingleModule2_length/2 - SiBarrel2_PassiveSi_Length/2" />
   <constant name="SiBarrel2_Passive4_Position" value="SiBarrel2_Module4_Position + SiBarrelSingleModule2_length/2 + SiBarrel2_PassiveSi_Length/2" />
   <constant name="SiBarrel2_Passive5_Position" value="SiBarrel2_Module5_Position + SiBarrelSingleModule2_length/2 + SiBarrel2_PassiveSi_Length/2" />
   <constant name="SiBarrel2_Passive6_Position" value="SiBarrel2_Module6_Position + SiBarrelSingleModule2_length/2 + SiBarrel2_PassiveSi_Length/2" />
   <constant name="SiBarrel2_Passive7_Position" value="SiBarrel2_Module7_Position + SiBarrelSingleModule2_length/2 + SiBarrel2_PassiveSi_Length/2" />

    <constant name="SiBarrelLayer1_length" value="SiBarrelStave1_length + 0.3*cm" />
    <constant name="SiBarrelLayer2_length" value="SiBarrelStave2_length + 2*mm" />
    <constant name="SiBarrelEnvelope_length" value="SiBarrelLayer2_length + 1*um" />
    <constant name="SiBarrelLayer_thickness" value="1.6*cm" />
    <constant name="SiBarrelLayer1_rmin" value="SiBarrelStave1_rc - SiBarrelLayer_thickness / 2" />
    <constant name="SiBarrelLayer1_rmax" value="SiBarrelLayer1_rmin + SiBarrelLayer_thickness" />
    <constant name="SiBarrelLayer2_rmin" value="SiBarrelStave2_rc -  SiBarrelLayer_thickness / 2 " />
    <constant name="SiBarrelLayer2_rmax" value="SiBarrelLayer2_rmin + SiBarrelLayer_thickness" />


    <constant name="HalfRSUwidth" value="19.564*mm" />
    <constant name="RSUcurvatureRadius" value="90.125*mm" />
    <constant name="RSUhalfAngle" value="HalfRSUwidth / RSUcurvatureRadius" />
    <constant name="RSUaxis" value="-RSUcurvatureRadius + SiBarrelSiliconHeightFromStaveCentre1"/>
    <constant name="LEClength" value="4.5*mm" />
    <constant name="REClength" value="1.5*mm" />
    <constant name="TileWidth" value="9.324*mm" />
    <constant name="TileLength" value="3.56*mm" />
    <constant name="LeftGap" value="0.09*mm" />
    <constant name="RightGap" value="0.02*mm" />
    <constant name="InterTileGap" value="0.02*mm" />
    <constant name="CentralTileGap" value="0.11*mm" />
    <constant name="CentralTileSpacing" value="0.12*mm" />
    <constant name="SideTileSpacing" value="0.398*mm" />
    <constant name="RSUlength" value="LeftGap + 6*TileLength + 4*InterTileGap + CentralTileGap + RightGap" /> <!-- 21.666mm -->
    <constant name="LASlength_6RSU" value="LEClength + 6*RSUlength + REClength" />
    <constant name="LASlength_5RSU" value="LEClength + 5*RSUlength + REClength" />


    </define>
      <detectors>
        <documentation level="5">
          ### Actual detectors
        </documentation>
        
           <HalfRSU name="HalfRepeatedSensorUnit"         
        sensor_stack="true"
        sensor_cu_thickness="SiBarrelSensorCu_thickness"
        sensor_active_si_thickness="SiBarrelSensorActiveSi_thickness"
        sensor_inactive_si_thickness="SiBarrelSensorInactiveSi_thickness">
        
         <rsu_component name="CurvedLeftEnd"
             material="Silicon"
             sensitive="false"
             nsegments="SiBarrelSiliconCurveNoSegments + 1"
             radius="RSUcurvatureRadius"
             phi0="-RSUhalfAngle"
             phi1="0.0"
             length="LeftGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="LeftGap/2 - RSUlength/2" z="0.0" />
        </rsu_component>
         <rsu_component name="CurvedRightEnd"
             material="Silicon"
             sensitive="false"
             nsegments="SiBarrelSiliconCurveNoSegments + 1"
             radius="RSUcurvatureRadius"
             phi0="-RSUhalfAngle"
             phi1="0.0"
             length="RightGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="-RightGap/2 + RSUlength/2" z="0.0" />
        </rsu_component>
         <rsu_component name="TopSpace"
             material="Silicon"
             sensitive="false"
             nsegments="1"
             radius="RSUcurvatureRadius"
             phi0="-RSUhalfAngle"
             phi1="-RSUhalfAngle + SideTileSpacing / RSUcurvatureRadius"
             length="RSUlength - LeftGap - RightGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="RSUlength/2 - (RSUlength - LeftGap - RightGap)/2" z="0.0" />
        </rsu_component>
         <rsu_component name="MiddleSpace"
             material="Silicon"
             sensitive="false"
             nsegments="1"
             radius="RSUcurvatureRadius"
             phi0="-RSUhalfAngle + (SideTileSpacing + TileWidth) / RSUcurvatureRadius"
             phi1="-RSUhalfAngle + (SideTileSpacing + TileWidth + CentralTileSpacing) / RSUcurvatureRadius"
             length="RSUlength - LeftGap - RightGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="RSUlength/2 - (RSUlength - LeftGap - RightGap)/2" z="0.0" />
        </rsu_component>
         <rsu_component name="BottonSpace"
             material="Silicon"
             sensitive="false"
             nsegments="1"
             radius="RSUcurvatureRadius"
             phi0="-SideTileSpacing / RSUcurvatureRadius"
             phi1="0.0"
             length="RSUlength - LeftGap - RightGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="RSUlength/2 - (RSUlength - LeftGap - RightGap)/2" z="0.0" />
        </rsu_component>
       <rsu_component name="Gap1"
             material="Silicon"
             sensitive="false"
             nsegments="SiBarrelSiliconCurveNoSegments/2"
             radius="RSUcurvatureRadius"
             phi0="-RSUhalfAngle + SideTileSpacing / RSUcurvatureRadius"
             phi1="-RSUhalfAngle + (SideTileSpacing + TileWidth) / RSUcurvatureRadius"
             length="InterTileGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="-RSUlength/2 + (LeftGap + TileLength) + InterTileGap/2" z="0.0" />
        </rsu_component>
       <rsu_component name="Gap2"
             material="Silicon"
             sensitive="false"
             nsegments="SiBarrelSiliconCurveNoSegments/2"
             radius="RSUcurvatureRadius"
             phi0="-RSUhalfAngle + SideTileSpacing / RSUcurvatureRadius"
             phi1="-RSUhalfAngle + (SideTileSpacing + TileWidth) / RSUcurvatureRadius"
             length="InterTileGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="-RSUlength/2 + (LeftGap + 2*TileLength + InterTileGap) + InterTileGap/2" z="0.0" />
        </rsu_component>
       <rsu_component name="Gap3"
             material="Silicon"
             sensitive="false"
             nsegments="SiBarrelSiliconCurveNoSegments/2"
             radius="RSUcurvatureRadius"
             phi0="-RSUhalfAngle + SideTileSpacing / RSUcurvatureRadius"
             phi1="-RSUhalfAngle + (SideTileSpacing + TileWidth) / RSUcurvatureRadius"
             length="CentralTileGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="-RSUlength/2 + (LeftGap + 3*TileLength + 2*InterTileGap) + CentralTileGap/2" z="0.0" />
        </rsu_component>
       <rsu_component name="Gap4"
             material="Silicon"
             sensitive="false"
             nsegments="SiBarrelSiliconCurveNoSegments/2"
             radius="RSUcurvatureRadius"
             phi0="-RSUhalfAngle + SideTileSpacing / RSUcurvatureRadius"
             phi1="-RSUhalfAngle + (SideTileSpacing + TileWidth) / RSUcurvatureRadius"
             length="InterTileGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="-RSUlength/2 + (LeftGap + 4*TileLength + 2*InterTileGap + CentralTileGap) + InterTileGap/2" z="0.0" />
        </rsu_component>
       <rsu_component name="Gap5"
             material="Silicon"
             sensitive="false"
             nsegments="SiBarrelSiliconCurveNoSegments/2"
             radius="RSUcurvatureRadius"
             phi0="-RSUhalfAngle + SideTileSpacing / RSUcurvatureRadius"
             phi1="-RSUhalfAngle + (SideTileSpacing + TileWidth) / RSUcurvatureRadius"
             length="InterTileGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="-RSUlength/2 + (LeftGap + 5*TileLength + 3*InterTileGap + CentralTileGap) + InterTileGap/2" z="0.0" />
        </rsu_component>
       <rsu_component name="Gap1a"
             material="Silicon"
             sensitive="false"
             nsegments="SiBarrelSiliconCurveNoSegments/2"
             radius="RSUcurvatureRadius"
             phi0="-(SideTileSpacing + TileWidth) / RSUcurvatureRadius"
             phi1="-SideTileSpacing  / RSUcurvatureRadius"
             length="InterTileGap"
             thickness="SiBarrelSensorMod_thickness"
             vis="TrackerLayerVis">
        <position x="0" y="-RSUlength/2 + (LeftGap + TileLength) + InterTileGap/2" z="0.0" />
        </rsu_component>
       <rsu_component name="Gap2a"
