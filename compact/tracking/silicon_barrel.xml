        <module_component name="K9_Split_CrossBrace_Sensor_4-077_ASCII.gdml" matching_name="K9" material="K9" sensitive="false" vis="TrackerLayerVis" file="CAD/L3/K9_Split_CrossBrace_Sensor_4-077_ASCII.gdml" />
