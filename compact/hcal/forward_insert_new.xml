<lccdd>

  <documentation>
    Title: Forward HCal Insert Calorimeter
    Author: @rymilton, @aidenwu23
    Status: development
    Version: 1.0
  </documentation>

  <define>
     <documentation>
      #### Material Thickness
    </documentation>
    <constant name="HcalEndcapPInsertAirThickness"               value="0.02*cm"/>
    <constant name="HcalEndcapPInsertAbsorberThickness"          value="1.52*cm"/>
    <constant name="HcalEndcapPInsertScintillatorCoverThickness" value="0.08*cm"/>
    <constant name="HcalEndcapPInsertPolystyreneThickness"       value="0.30*cm"/>
    <constant name="HcalEndcapPInsertPCBThickness"               value="0.08*cm"/>
    <constant name="HcalEndcapPInsertESRFoilThickness"           value="0.015*cm"/>

    <constant name="LFHCAL_FrontWallThickness"                   value="1.50*cm"/>

    <documentation>
      - Insert N Layers and computed Thickness
    </documentation>

    <constant name="HcalEndcapPInsertFrontLayerThickness"
      value="LFHCAL_FrontWallThickness +
             HcalEndcapPInsertAirThickness +
             HcalEndcapPInsertScintillatorCoverThickness +
             HcalEndcapPInsertESRFoilThickness +
             HcalEndcapPInsertPolystyreneThickness +
             HcalEndcapPInsertESRFoilThickness +
             HcalEndcapPInsertPCBThickness +
             HcalEndcapPInsertAirThickness "
    />
    <constant name="HcalEndcapPInsertSingleLayerThickness"
      value="HcalEndcapPInsertAbsorberThickness +
             HcalEndcapPInsertAirThickness +
             HcalEndcapPInsertScintillatorCoverThickness +
             HcalEndcapPInsertESRFoilThickness +
             HcalEndcapPInsertPolystyreneThickness +
             HcalEndcapPInsertESRFoilThickness +
             HcalEndcapPInsertPCBThickness +
             HcalEndcapPInsertAirThickness "
    />
    <constant name="HcalEndcapPInsertBackplateThickness"    value="HcalEndcapPInsertAbsorberThickness"/>
    <constant name="HcalEndcapPInsertLayer_NSteelRepeat"    value="60"/>
    <constant name="HcalEndcapPInsert_pcb_length" value="HcalEndcapPInsertLayer_NSteelRepeat * HcalEndcapPInsertSingleLayerThickness + HcalEndcapPInsertBackplateThickness"/>
    <constant name="HcalEndcapPInsert_left_radius" value="16.781*cm"/>
    <constant name="HcalEndcapPInsert_center_x" value="-10.0*cm"/>
    <constant name="HcalEndcapPInsert_center_y" value="0.0*cm"/>
    <constant name="HcalEndcapPInsert_right_radius" value="16.786*cm"/>
    <constant name="HcalEndcapPInsert_rect_width" value="18.84*cm"/>
    <constant name="HcalEndcapPInsert_rect_height" value="33.41*cm"/>
    <constant name="HcalEndcapPInsert_h_pcb_slot_width" value="15.0*cm"/>
    <constant name="HcalEndcapPInsert_h_pcb_slot_height" value="0.5*cm"/>
    <constant name="HcalEndcapPInsert_v_pcb_slot_width" value="0.5*cm"/>
    <constant name="HcalEndcapPInsert_right_v_pcb_slot_height" value="11.0*cm"/>
    <constant name="HcalEndcapPInsert_left_v_pcb_slot_height" value="14.5*cm"/>
    <constant name="HcalEndcapPInsert_v_pcb_slot_offset_y" value="1.0*cm"/>
    <constant name="HcalEndcapPInsert_pcb_thickness" value="0.16*cm"/>
    <constant name="HcalEndcapPInsert_pcb_edge_clearance" value="0.4*cm"/>
    <constant name="HcalEndcapPInsert_tile_size" value="4.7*cm"/>
    <constant name="HcalEndcapPInsert_tile_gap" value="0.02*cm"/>
    <constant name="HcalEndcapPInsert_casing_length" value="132.0*cm"/>
    <constant name="HcalEndcapPInsert_casing_thickness" value="0.34163*cm"/>
    <constant name="HcalEndcapPInsert_casing_left_radius" value="16.781*cm"/>
    <constant name="HcalEndcapPInsert_pcb_cover_thickness" value="0.19844*cm"/>
    <constant name="HcalEndcapPInsert_right_back_cutout_margin" value="4.0*cm"/>
    <constant name="HcalEndcapPInsert_left_back_cutout_margin" value="3.5*cm"/>
    <constant name="HcalEndcapPInsert_back_cutout_vertical_margin" value="3.5*cm"/>
  </define>

  <detectors>
     <documentation>
      ### Forward (Positive Z) Endcap Insert for Hadronic Calorimeter
      Insert goes in the middle of the forward endcap HCal -- around the beampipe

      Insert is 60 layers of Steel/Sc + 1 backplate of steel
      Each of the layers (sans backplate) includes air gaps (front and back of each layer),
      ESR foil (front and back of scintillator), a PCB, and an aluminum scitnillator cover

      A cylindrical hole is cut out from each layer to account for the beampipe
      Hole radius is beampipe radius + 3.85 cm of clearance

    </documentation>
    <detector
      id="HcalEndcapPInsert_ID"
      name="HcalEndcapPInsert"
      type="epic_InsertCalorimeter_new"
      vis="HcalEndcapInsertVis"
      readout="HcalEndcapPInsertHits"
      calorimeterType="HAD_ENDCAP"
      left_right_gap="0.38*cm"
    >
      <type_flags type="DetType_CALORIMETER + DetType_ENDCAP + DetType_HADRONIC"/>
      <position x="HcalEndcapPInsert_xposition" y="HcalEndcapPInsert_yposition" z="HcalEndcapPInsert_zmin"/>
      <dimensions
        x="HcalEndcapPInsert_width"
        y="HcalEndcapPInsert_height"
        z="HcalEndcapPInsert_length"
      />
      <comment> Steel/Sc layers </comment>
      <layer repeat="HcalEndcapPInsertLayer_NSteelRepeat" thickness="HcalEndcapPInsertSingleLayerThickness" vis="InvisibleWithDaughters">
        <slice material="Steel235" thickness="HcalEndcapPInsertAbsorberThickness" vis="AnlRed"/>
        <slice material="Air" thickness="HcalEndcapPInsertAirThickness"/>
        <slice material="Aluminum" thickness="HcalEndcapPInsertScintillatorCoverThickness" vis="AnlProcess_Blue"/>
        <slice material="Polystyrene" thickness="HcalEndcapPInsertESRFoilThickness" vis="AnlGray"/>
        <slice material="Polystyrene" thickness="HcalEndcapPInsertPolystyreneThickness"  sensitive="true" limits="cal_limits" vis="AnlLightGray"/>
        <slice material="Polystyrene" thickness="HcalEndcapPInsertESRFoilThickness" vis="AnlGray"/>
        <slice material="Fr4" thickness="HcalEndcapPInsertPCBThickness" vis="AnlDarkGreen"/>
        <slice material="Air" thickness="HcalEndcapPInsertAirThickness"/>
      </layer>
      <comment> Final layer of steel </comment>
      <layer repeat="1" thickness="HcalEndcapPInsertBackplateThickness">
        <slice material="Steel235" thickness="HcalEndcapPInsertBackplateThickness" vis="AnlRed"/>
      </layer>
      <documentation>
        beampipe_cutout: Beam-pipe circle and right-side rectangular cutout
        pcb_slots: Horizontal and vertical PCB slot dimensions
        pcb_boards: Physical PCB dimensions and slot clearance
        tiles: Physical scintillator tile size and gap
        casing: Steel casing length and wall thickness
        pcb_covers: Stainless PCB cover thickness and material
        backplate_cutouts: Rear casing cutout margins

        The tile grid has twelve rows centered vertically at y=0. The top row is at
        y=5.5*(tile_size+tile_gap), and row IDs increase from top to bottom.

        Tile counts per row from top to bottom:
          left side:  4, 4, 4, 3, 3, 2, 2, 3, 3, 4, 4, 4
          right side: 8, 8, 4, 3, 2, 2, 2, 2, 3, 4, 8, 8

        Tiles are placed from each outer edge toward the center. Both sides' x IDs start at
        zero and increase inward.
        The right-side clearance between the innermost tile and central PCB slot is four
        times its outer-edge margin.

        Two left-side tiles cross the circular cutout. Their placement indices are
        (row, column)=(4, 2) and (7, 2), corresponding to cell IDs (x, y)=(2, 4) and
        (2, 7). Matching air pockets extend the layer container around these tiles.
      </documentation>
      <beampipe_cutout
        left_radius="HcalEndcapPInsert_left_radius"
        center_x="HcalEndcapPInsert_center_x"
        center_y="HcalEndcapPInsert_center_y"
        right_radius="HcalEndcapPInsert_right_radius"
        rect_width="HcalEndcapPInsert_rect_width"
        rect_height="HcalEndcapPInsert_rect_height"
      />
      <pcb_slots
        horizontal_width="HcalEndcapPInsert_h_pcb_slot_width"
        horizontal_height="HcalEndcapPInsert_h_pcb_slot_height"
        vertical_width="HcalEndcapPInsert_v_pcb_slot_width"
        right_vertical_height="HcalEndcapPInsert_right_v_pcb_slot_height"
        left_vertical_height="HcalEndcapPInsert_left_v_pcb_slot_height"
        vertical_offset_y="HcalEndcapPInsert_v_pcb_slot_offset_y"
      />
      <pcb_boards
        length="HcalEndcapPInsert_pcb_length"
        thickness="HcalEndcapPInsert_pcb_thickness"
        edge_clearance="HcalEndcapPInsert_pcb_edge_clearance"
      />
      <tiles
        size="HcalEndcapPInsert_tile_size"
        gap="HcalEndcapPInsert_tile_gap"
      />
      <casing
        length="HcalEndcapPInsert_casing_length"
        thickness="HcalEndcapPInsert_casing_thickness"
        left_radius="HcalEndcapPInsert_casing_left_radius"
        material="Steel235"
        vis="AnlOrange"
      />
      <pcb_covers
        thickness="HcalEndcapPInsert_pcb_cover_thickness"
        material="StainlessSteelSAE304"
        vis="AnlOrange"
      />
      <backplate_cutouts
        right_margin="HcalEndcapPInsert_right_back_cutout_margin"
        left_margin="HcalEndcapPInsert_left_back_cutout_margin"
        vertical_margin="HcalEndcapPInsert_back_cutout_vertical_margin"
      />
    </detector>
  </detectors>

  <readouts>
    <documentation>
      Each physical scintillator tile is one readout cell.
      The side, layer, slice, x (column number), and y (row number) placements define its cell ID.
    </documentation>
    <readout name="HcalEndcapPInsertHits">
      <segmentation type="NoSegmentation"/>
      <id>system:8,side:1,layer:8,slice:7,x:32:-16,y:-16</id>
    </readout>

  </readouts>

</lccdd>
